        <script><![CDATA[function onSubmit() {

    var minLength = 50;
	var just = g_form.getValue('justification');
	g_form.addInfoMessage(just);
    var currentLength =just.trim().length;
	

    
    g_form.hideFieldMsg('justification');

    if (currentLength < minLength) {
        var remaining = minLength - currentLength;
        g_form.showFieldMsg('justification', 'Business Justification is too short. Please add ' + remaining + ' more character(s).', 'error');
		return false;
    }
   
}]]></script>
