        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var ga = new GlideAjax('UserDetailsAjax');
    ga.addParam('sysparm_name', 'getRemainBudget');
    ga.addParam('sysparm_Quarter', g_form.getValue("quarter"));
    ga.addParam('sysparm_dept', g_form.getValue('department'));

    ga.getXMLAnswer(handleResponse);

    function handleResponse(response) {
		g_form.addInfoMessage(response);
        if (response != '') {

            g_form.setValue('department_budget_remaining' , response);
			


        }

    }

}]]></script>
