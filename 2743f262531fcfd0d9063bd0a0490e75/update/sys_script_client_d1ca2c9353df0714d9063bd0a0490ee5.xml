        <condition/>
        <description/>
        <field>u_min_value</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>MinValueNegative</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') { 
        return; 
    }

   
    var gaRaw = g_form.getValue('u_min_value'); 
    
    
    var gaNumeric = gaRaw.replace(/[^0-9.-]/g, '');
    
    
    var ga = parseFloat(gaNumeric);

   
    if (!isNaN(ga) && ga < 0) { 
        g_form.addErrorMessage('Min Value Cannot Be Negative'); 
        
       
        g_form.setValue('u_min_value', ''); 
    }
}
]]></script>
