        <script><![CDATA[var UserDetailsAjax = Class.create();
UserDetailsAjax.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	getDepartment:function(){
		var user_id=this.getParameter('sysparm_user_id');
		var gr=new GlideRecord('sys_user');
		if(gr.get(user_id)){
			if(gr.department.toString()){
				return gr.department.toString();
			}
		}
		return "";
	},

    type: 'UserDetailsAjax'
